<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" pannable="true" stylesheets="@generate.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cv_builder.SavedCVsController">

    <content>

        <StackPane alignment="TOP_CENTER" styleClass="root-stackpane">

            <HBox maxWidth="900" styleClass="main-hbox">

                <!-- LEFT SIDEBAR (same as generate.fxml, but simplified) -->
                <VBox prefWidth="300" spacing="20" styleClass="left-vbox">

                    <Label styleClass="section-title" text="Saved CVs" wrapText="true" />

                    <ListView fx:id="listView" prefHeight="600" prefWidth="260" style="-fx-background-color: transparent;" />

                </VBox>

                <!-- RIGHT MAIN CONTENT -->
                <VBox prefWidth="600" spacing="25" styleClass="right-vbox">

                    <!-- Title Box -->
                    <VBox spacing="5" styleClass="name-box">
                        <Label styleClass="full-name" text="Manage Saved CVs" />
                        <Label styleClass="job-title" text="Select, open or modify existing CV records." />
                    </VBox>

                    <!-- Back Button -->
                    <AnchorPane>
                        <Button fx:id="backHomeButton" layoutX="180.0" layoutY="14.0" onAction="#backToHome" prefHeight="45" prefWidth="160" styleClass="back-button" text="Back Home" />
                        <padding>
                            <Insets top="40.0" />
                        </padding>
                    </AnchorPane>

                    <!-- Four action buttons below back button -->
                    <HBox alignment="CENTER" spacing="20">
                        <Button onAction="#onNewCV" prefHeight="39.0" prefWidth="121.0" styleClass="button-box" text="New" />

                        <Button onAction="#onOpenSelected" prefHeight="35" prefWidth="120" styleClass="button-box" text="Open" />

                        <Button onAction="#onEditSelected" prefHeight="35" prefWidth="120" styleClass="button-box" text="Edit" />

                        <!-- ✅ NEW DELETE BUTTON -->
                        <Button onAction="#onDeleteSelected" prefHeight="35" prefWidth="120" styleClass="button-box" text="Delete" />
                    </HBox>


                </VBox>

            </HBox>

        </StackPane>

    </content>

</ScrollPane>
