<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" pannable="true" stylesheets="@generate.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cv_builder.GenerateController">

    <content>

        <StackPane alignment="TOP_CENTER" styleClass="root-stackpane">

            <HBox maxWidth="900" styleClass="main-hbox">

                <VBox prefWidth="300" spacing="20" styleClass="left-vbox">

                    <ImageView fx:id="profileImageView" fitHeight="150" fitWidth="150" preserveRatio="true" styleClass="profile-image" />

                    <VBox spacing="10" styleClass="contact-box">
                        <Label styleClass="section-title" text="CONTACT" />
                        <Label fx:id="emailLabel" styleClass="section-label" wrapText="true" />
                        <Label fx:id="phoneLabel" styleClass="section-label" wrapText="true" />
                        <Label fx:id="addressLabel" styleClass="section-label" wrapText="true" />
                    </VBox>

                    <VBox spacing="10" styleClass="skills-box">
                        <Label styleClass="section-title" text="SKILLS" />
                        <Label fx:id="skillsLabel" styleClass="section-label" wrapText="true" />
                    </VBox>

                    <VBox spacing="10" styleClass="languages-box">
                        <Label styleClass="section-title" text="LANGUAGES" />
                        <Label fx:id="languagesLabel" styleClass="section-label" wrapText="true" />
                    </VBox>

                </VBox>

                <VBox prefWidth="600" spacing="25" styleClass="right-vbox">

                    <VBox spacing="5" styleClass="name-box">
                        <Label fx:id="fullNameLabel" styleClass="full-name" />
                        <Label fx:id="jobTitleLabel" styleClass="job-title" />
                    </VBox>

                    <VBox spacing="10" styleClass="projects-box">
                        <Label styleClass="section-header" text="PROJECTS" />
                        <Label fx:id="aboutLabel" styleClass="section-content" wrapText="true" />
                    </VBox>

                    <VBox spacing="10" styleClass="experience-box">
                        <Label styleClass="section-header" text="WORK EXPERIENCE" />
                        <Label fx:id="experienceLabel" styleClass="section-content" wrapText="true" />
                    </VBox>

                    <VBox spacing="10" styleClass="education-box">
                        <Label styleClass="section-header" text="EDUCATION" />
                        <Label fx:id="educationLabel" styleClass="section-content" wrapText="true" />
                    </VBox>

                    <AnchorPane>
                        <Button fx:id="backHomeButton" layoutX="200" layoutY="20" onAction="#backToHome" prefHeight="45" prefWidth="160" styleClass="back-button" text="Back Home" />
                    </AnchorPane>

                </VBox>

            </HBox>

        </StackPane>

    </content>

</ScrollPane>
